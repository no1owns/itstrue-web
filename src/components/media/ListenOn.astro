---
interface Props {
  links: { platform: string; url: string }[];
  label?: string;
}
const { links, label = 'Listen on' } = Astro.props;
---

{links.length > 0 && (
  <div class="listen-on">
    <h2 class="label">{label}</h2>
    <ul>
      {links.map((link) => (
        <li>
          <a class="button button--ghost" href={link.url} rel="noopener">
            {link.platform}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .label {
    font-size: var(--step-0);
    margin-bottom: var(--space-2);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
