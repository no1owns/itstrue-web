---
// Native audio player for an episode's RSS enclosure. The browser's own
// controls are keyboard- and screen-reader-accessible; preload="none" means
// nothing downloads until the visitor presses play.
interface Props {
  src: string;
  type?: string;
  title: string;
}
const { src, type, title } = Astro.props;
---

<figure class="audio">
  <figcaption class="visually-hidden">Listen: {title}</figcaption>
  <audio controls preload="none">
    <source src={src} type={type} />
    <a href={src}>Download the episode audio</a>
  </audio>
</figure>

<style>
  .audio {
    margin: 0;
  }
  audio {
    width: 100%;
  }
</style>
