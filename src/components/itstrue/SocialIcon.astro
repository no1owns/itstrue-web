---
// Outline platform icons from the handoff's Follow and footer markup.
interface Props {
  name: 'instagram' | 'tiktok' | 'youtube';
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
    </>
  )}
  {name === 'tiktok' && (
    <>
      <path d="M14 3.5v11.2a3.6 3.6 0 1 1-3.6-3.6" />
      <path d="M14 3.5c.4 2.6 2.1 4.2 5 4.4" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <rect x="2.8" y="5.5" width="18.4" height="13" rx="4" />
      <path d="M10 9.2v5.6l5-2.8z" />
    </>
  )}
</svg>
