---
// Appearances. No events are listed until dates, venues and ticket links
// are confirmed.
---

<section class="sec events" id="events" aria-labelledby="e-h">
  <div class="wrap">
    <div class="ev">
      <div>
        <p class="k">Events</p>
        <h2 class="st" id="e-h">
          Appearances
        </h2>
      </div>
      <div class="ev__body">
        <span class="mt-status mt-status--tbd">No public events listed</span>
        <p class="lede">Appearances are listed here once dates, venues and ticket links are confirmed.</p>
        <a class="btn btn--secondary" href="#book">
          Book the Twins for your event <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
