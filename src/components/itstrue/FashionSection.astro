---
// Spend DaT Bread. Concept images only: no store, prices, sizes or launch
// date. The headline keeps the exact casing "DaT" and is never uppercased.
// The reference's "See the lookbook" button is omitted (no lookbook page).
import { url } from '../../lib/paths';
---

<section class="sec fashion" id="fashion" aria-labelledby="f-h">
  <div class="wrap f__grid">
    <div class="f__copy">
      <div class="f__mark">
        <figure class="paper sd__wm">
          <img
            src={url('/images/home/pk_sdb-wordmark.jpg')}
            width="660"
            height="90"
            alt="Spend DaT Bread wordmark"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <p class="k">Clothing brand</p>
      <h2 class="st st--xl" id="f-h">
        Spend DaT Bread
      </h2>
      <p class="lede">Discover the developing clothing collection and the creative identity behind the brand.</p>
      <div class="f__row">
        <span class="mt-status mt-status--dev">Collection in development</span>
      </div>
      <p class="note">Concept images. Collection in development.</p>
    </div>
    <div class="f__imgs">
      <figure class="ph f__a">
        <img
          src={url('/images/home/pk_sdb-9538.jpg')}
          width="1400"
          height="933"
          alt="Two men in layered winter clothing outside a stone building, a styling concept for Spend DaT Bread"
          loading="lazy"
          decoding="async"
        />
        <span class="chip">Concept</span>
      </figure>
      <figure class="ph f__b paperfig">
        <img
          src={url('/images/home/pk_sdb-9550.jpg')}
          width="1400"
          height="933"
          alt="Spend DaT Bread jogger edit catalog sheet showing slim joggers in black, taupe and burgundy"
          loading="lazy"
          decoding="async"
        />
        <span class="chip">Concept</span>
      </figure>
    </div>
  </div>
</section>
