          hip-hop dance, featuring young performers up to age 21.
        </p>
        <dl class="mt-facts">
          <div>
            <dt>When</dt>
            <dd>Planned mid-July 2027</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Venue to be announced</dd>
          </div>
          <div>
            <dt>Auditions</dt>
            <dd>To be announced</dd>
          </div>
          <div>
            <dt>Who</dt>
            <dd>Youth and young adults up to age 21</dd>
          </div>
        </dl>
        <div class="musical__row">
          <a class="mt-btn mt-btn--primary" href="#follow">
            Follow for updates{' '}
            <svg class="mt-btn__arrow" viewBox="0 0 18 12" aria-hidden="true" focusable="false">
              <path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"></path>
            </svg>
          </a>
          <span class="mt-status mt-status--dev">Planned</span>
        </div>
      </div>
    </div>
  </div>
</section>

