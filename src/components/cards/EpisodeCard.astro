---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { episodeHref, formatDate } from '../../lib/content';

interface Props {
  episode: CollectionEntry<'episodes'>;
  showTitle?: string;
}
const { episode, showTitle } = Astro.props;
const { data } = episode;
const number = data.episode ? `Ep. ${data.season ? `${data.season}.` : ''}${data.episode}` : '';
const meta = [showTitle, number, formatDate(data.date), data.durationMinutes && `${data.durationMinutes} min`]
  .filter(Boolean)
  .join(' · ');
---

<Card href={episodeHref(episode)} title={data.title} image={data.image} meta={meta} placeholder={data.placeholder} />
