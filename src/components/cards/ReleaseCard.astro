---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';

interface Props {
  release: CollectionEntry<'releases'>;
}
const { release } = Astro.props;
const { data } = release;
const type = { single: 'Single', ep: 'EP', album: 'Album', mixtape: 'Mixtape', other: 'Release' }[data.type];
const meta = [data.artists.join(', '), type, data.releaseDate?.getUTCFullYear()].filter(Boolean).join(' · ');
---

<Card href={`/music/releases/${release.id}/`} title={data.title} image={data.artwork} meta={meta} />
