---
import { site } from '../../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'music.song' | 'music.album' | 'video.episode';
}

const { title, description = site.description, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
// Without a confirmed public URL there is no canonical origin, so pages ask
// search engines not to index preview deployments.
const indexable = Boolean(Astro.site);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : image;
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}
{!indexable && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:type" content={type} />
{description && <meta property="og:description" content={description} />}
{canonical && <meta property="og:url" content={canonical} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
