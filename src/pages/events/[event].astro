---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import YouTubeEmbed from '../../components/media/YouTubeEmbed.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { formatDate } from '../../lib/content';

export const getStaticPaths = (async () => {
  const events = await getCollection('events', (e) => e.data.published);
  return events.map((event) => ({ params: { event: event.id }, props: { event } }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const { data } = event;
const isPast = (data.end ?? data.start) < new Date();
const time = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: data.timezone ?? 'UTC', timeZoneName: 'short' }).format(data.start);
const place = [data.venue, data.city].filter(Boolean).join(', ');
const statusLabel = { announced: '', 'on-sale': '', 'sold-out': 'Sold out', cancelled: 'Cancelled', postponed: 'Postponed' }[data.status];
const eventStatus = { cancelled: 'EventCancelled', postponed: 'EventPostponed' }[data.status as string] ?? 'EventScheduled';
---

<BaseLayout title={data.title} description={data.description} image={data.image?.src}>
  <JsonLd
    slot="head"
    data={{
      '@type': 'Event',
      name: data.title,
      startDate: data.start.toISOString(),
      endDate: data.end?.toISOString(),
      eventStatus: `https://schema.org/${eventStatus}`,
      ...(place && { location: { '@type': 'Place', name: data.venue ?? data.city, address: data.city } }),
      ...(data.ticketUrl && { offers: { '@type': 'Offer', url: data.ticketUrl } }),
      image: data.image?.src,
      description: data.description,
    }}
  />

  <PageHeader title={data.title} eyebrow={isPast ? 'Past event' : statusLabel || 'Upcoming'}>
    <p class="when">
      <time datetime={data.start.toISOString()}>{formatDate(data.start, data.timezone)}, {time}</time>
      {place && <><br />{place}</>}
    </p>
    {
      !isPast && data.ticketUrl && data.status !== 'cancelled' && data.status !== 'sold-out' && (
        <a class="button" href={data.ticketUrl} rel="noopener">Get tickets</a>
      )
    }
  </PageHeader>

  <div class="wrap event">
    {data.image && <img src={data.image.src} alt={data.image.alt} />}
    {data.description && <p class="prewrap">{data.description}</p>}
    {data.lineup.length > 0 && <p><strong>Lineup:</strong> {data.lineup.join(', ')}</p>}
    {data.recapYoutubeId && <YouTubeEmbed id={data.recapYoutubeId} title={`${data.title} recap`} />}
    <p><a href="/events/">All events</a></p>
  </div>
</BaseLayout>

<style>
  .when {
    font-size: var(--step-1);
  }
  .event {
    display: grid;
    gap: var(--space-4);
  }
</style>
