---
// Shown by GitHub Pages for any address that doesn't exist. Uses the
// homepage design; header and footer links point back to the homepage.
import ItsTrueLayout from '../layouts/ItsTrueLayout.astro';
import { brand } from '../data/home';
import { url } from '../lib/paths';
---

<ItsTrueLayout
  title={`Page not found | ${brand.name}`}
  description="That page doesn't exist or has moved."
  home={url('/')}
>
  <section class="sec">
    <div class="wrap">
      <p class="k">Page not found</p>
      <h1 class="st">That page doesn’t exist or has moved.</h1>
      <p class="lede">Head back to the homepage to find what you’re looking for.</p>
      <p class="back">
        <a class="btn btn--primary btn--xl" href={url('/')}>
          Back to the homepage <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>
</ItsTrueLayout>

<style>
  .back {
    margin-top: var(--space-8);
  }
</style>
