---
// It's True Entertainments homepage: owner-review preview of "Homepage Work 1"
// (design handoff 2026-10-31). Pre-launch and noindex; not the final website.
import ItsTrueLayout from '../layouts/ItsTrueLayout.astro';
import Hero from '../components/itstrue/Hero.astro';
import About from '../components/itstrue/About.astro';
import WorkIndex from '../components/itstrue/WorkIndex.astro';
import MusicSection from '../components/itstrue/MusicSection.astro';
import PodcastSection from '../components/itstrue/PodcastSection.astro';
import FashionSection from '../components/itstrue/FashionSection.astro';
import MusicalSection from '../components/itstrue/MusicalSection.astro';
import EventsSection from '../components/itstrue/EventsSection.astro';
import BookingSection from '../components/itstrue/BookingSection.astro';
import FollowSection from '../components/itstrue/FollowSection.astro';
import ClosingCta from '../components/itstrue/ClosingCta.astro';
import { brand } from '../data/home';
---

<ItsTrueLayout
  title={`${brand.name} | ${brand.tagline} (preview)`}
  description="Acting, modeling, dance, music, hosting, production, podcast and fashion from Twin Chino and TwinCasso."
>
  <Hero />
  <About />
  <WorkIndex />
  <MusicSection />
  <PodcastSection />
  <FashionSection />
  <MusicalSection />
  <EventsSection />
  <BookingSection />
  <FollowSection />
  <ClosingCta />
</ItsTrueLayout>
