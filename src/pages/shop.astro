---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import EmptyState from '../components/layout/EmptyState.astro';
import { site } from '../lib/site';

// Commerce lives on an external platform (to be confirmed). Until a store
// embed is chosen, this page links out to site.shopUrl when one is set.
const division = await getEntry('divisions', 'shop');
---

<BaseLayout title={division?.data.name ?? 'Shop'} description={division?.data.description}>
  <PageHeader title={division?.data.name ?? 'Shop'} intro={division?.data.tagline} />
  <div class="wrap">
    {
      site.shopUrl ? (
        <a class="button" href={site.shopUrl} rel="noopener">
          Visit the store
        </a>
      ) : (
        <EmptyState message="The store is coming soon." />
      )
    }
  </div>
</BaseLayout>
