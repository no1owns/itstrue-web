---
// Landing page for any division with template "generic". Adding a new
// business line is a new file in src/content/divisions/, not new code.
import { asset, url } from '../lib/paths';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { getDivisions } from '../lib/content';

export const getStaticPaths = (async () => {
  const divisions = (await getDivisions()).filter((d) => d.data.template === 'generic');
  return divisions.map((division) => ({ params: { division: division.id }, props: { division } }));
}) satisfies GetStaticPaths;

const { division } = Astro.props;
const { data } = division;
---

<BaseLayout title={data.name} description={data.description} image={data.hero?.src}>
  <PageHeader title={data.name} intro={data.tagline} />
  <div class="wrap">
    {data.hero && <img src={asset(data.hero.src)} alt={data.hero.alt} />}
    {data.description && <p class="prewrap">{data.description}</p>}
    <p>
      <a class="button" href={url('/book/')}>
        Get in touch
      </a>
    </p>
  </div>
</BaseLayout>
