---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/layout/EmptyState.astro';
import ShowCard from '../../components/cards/ShowCard.astro';
import EpisodeCard from '../../components/cards/EpisodeCard.astro';
import { getEntry } from 'astro:content';
import { getShows, getEpisodes } from '../../lib/content';

const division = await getEntry('divisions', 'podcasts');
const shows = await getShows();
const showTitles = new Map(shows.map((s) => [s.id, s.data.title]));
const latest = (await getEpisodes()).slice(0, 6);
---

<BaseLayout title={division?.data.name ?? 'Podcasts'} description={division?.data.description}>
  <PageHeader title={division?.data.name ?? 'Podcasts'} intro={division?.data.tagline} />

  <section class="section wrap" aria-labelledby="shows-heading">
    <h2 id="shows-heading">Shows</h2>
    {
      shows.length ? (
        <ul class="grid">
          {shows.map((show) => (
            <li>
              <ShowCard show={show} />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="No shows published yet." />
      )
    }
  </section>

  {
    latest.length > 0 && (
      <section class="section wrap" aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest episodes</h2>
        <ul class="grid">
          {latest.map((e) => (
            <li>
              <EpisodeCard episode={e} showTitle={showTitles.get(e.data.show.id)} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
