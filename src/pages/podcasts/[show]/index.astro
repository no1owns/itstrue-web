---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import EmptyState from '../../../components/layout/EmptyState.astro';
import EpisodeCard from '../../../components/cards/EpisodeCard.astro';
import ListenOn from '../../../components/media/ListenOn.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { getEntries } from 'astro:content';
import { getShows, getEpisodes } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const shows = await getShows();
  return shows.map((show) => ({ params: { show: show.id }, props: { show } }));
}) satisfies GetStaticPaths;

const { show } = Astro.props;
const episodes = await getEpisodes(show.id);
const hosts = (await getEntries(show.data.hosts)).filter((h) => h?.data.published);
const rss = show.data.feeds.rss;
---

<BaseLayout title={show.data.title} description={show.data.description} image={show.data.artwork?.src}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={show.data.title} href={rss} />
  <JsonLd
    slot="head"
    data={{
      '@type': 'PodcastSeries',
      name: show.data.title,
      description: show.data.description,
      image: show.data.artwork?.src,
      webFeed: rss,
    }}
  />

  <PageHeader title={show.data.title} eyebrow="Podcast">
    <div class="show-intro">
      {show.data.artwork && <img class="artwork" src={show.data.artwork.src} alt={show.data.artwork.alt} width="240" height="240" />}
      <div>
        {show.data.description && <p class="prewrap">{show.data.description}</p>}
        {hosts.length > 0 && <p class="muted">Hosted by {hosts.map((h) => h.data.name).join(', ')}</p>}
        <ListenOn links={[...show.data.links, ...(rss ? [{ platform: 'RSS', url: rss }] : [])]} />
      </div>
    </div>
  </PageHeader>

  <section class="section wrap" aria-labelledby="episodes-heading">
    <h2 id="episodes-heading">Episodes</h2>
    {
      episodes.length ? (
        <ul class="grid">
          {episodes.map((e) => (
            <li>
              <EpisodeCard episode={e} />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState message="Episodes will appear here once the show's feed is connected." />
      )
    }
  </section>
</BaseLayout>

<style>
  .show-intro {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 48rem) {
    .show-intro {
      grid-template-columns: 15rem 1fr;
    }
  }
  .artwork {
    border-radius: var(--radius);
  }
</style>
