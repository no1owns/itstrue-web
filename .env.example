# Copy to .env for local development. Never commit real values.
# All of these are optional locally.

# Public origin and base path. The GitHub Pages deploy workflow sets these
# from the Pages configuration; leave empty to serve from the root locally.
# To mimic the project URL: SITE_URL=https://no1owns.github.io BASE_PATH=/moneytakers-web
SITE_URL=
BASE_PATH=

# Launch switch. Leave false until launch: every page is noindex, robots.txt
# disallows crawling, and placeholder content shows with visible labels.
SITE_LIVE=false

# External form service that receives booking inquiries (e.g. Formspree).
# While empty, the form is shown but its submit button is disabled.
PUBLIC_FORM_ENDPOINT=
