# Copy to .env for local development. Never commit real values.

# Final public HTTPS origin, e.g. https://example.com (Needs confirmation).
# While blank, pages are marked noindex and no sitemap URLs are emitted.
SITE_URL=

# Endpoint that receives booking/inquiry form POSTs (Formspree-style, or a
# host function once hosting is chosen). While blank, the form shows a notice
# and its submit button is disabled.
PUBLIC_FORM_ENDPOINT=
